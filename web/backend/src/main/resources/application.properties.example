# Server Configuration
server.port=8080
spring.application.name=smart-queue-web

# Database Configuration (reads environment variables with fallback)
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:${DB_PORT:3307}/smart_queue_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC}
spring.datasource.username=${DB_USER:root}
spring.datasource.password=${DB_PASSWORD:root}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Hikari Connection Pool
spring.datasource.hikari.maximum-pool-size=10
spring.datasource.hikari.minimum-idle=2
spring.datasource.hikari.idle-timeout=30000
spring.datasource.hikari.connection-timeout=5000
spring.datasource.hikari.pool-name=SmartQueue-Spring-MySQL-Pool

# JPA / Hibernate - Schema is managed strictly by SQL migration scripts
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# JWT Configuration
jwt.secret=${JWT_SECRET:404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970}
jwt.expiration-ms=900000
jwt.refresh-expiration-ms=604800000
jwt.cookie-name=smartqueue_jwt
jwt.refresh-cookie-name=smartqueue_refresh

# Actuator & Health Endpoints
management.endpoints.web.exposure.include=health,info
management.endpoint.health.show-details=always

# Swagger UI / OpenAPI
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.api-docs.path=/api-docs

# App business parameters (matching desktop app)
app.starvation_threshold_minutes=30
app.default_service_duration_minutes=5

# Anti-starvation promotion threshold (set to 1 for live demo, 30 for production)
app.queue.promotion-minutes=1
